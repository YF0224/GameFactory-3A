{
  "game_id": "G003_gggame_courtyard_rps",
  "whitebox": {
    "mechanic": [
      {
        "id": "G003_gggame_courtyard_rps.WB.TC2.01",
        "col": "C2",
        "text": "双客户端进入同一对局：通过两个真实客户端完成原生入房和房主开局，双方进入同一局猜拳。"
      },
      {
        "id": "G003_gggame_courtyard_rps.WB.TC2.02",
        "col": "C2",
        "text": "隐藏提交与统一揭晓：双方提交期间不可见对方手势；齐交后按两种手势的标准猜拳规则揭晓胜负，单种或三种为平局。"
      },
      {
        "id": "G003_gggame_courtyard_rps.WB.TC2.03",
        "col": "C2",
        "text": "胜者获得行动步：非平局揭晓后，胜者获得等于败者人数的步数，败者获得零步。"
      },
      {
        "id": "G003_gggame_courtyard_rps.WB.TC2.04",
        "col": "C2",
        "text": "七连败补偿：七次连续失败触发三步补偿；平局不增加也不中断失败序列。"
      },
      {
        "id": "G003_gggame_courtyard_rps.WB.TC2.05",
        "col": "C2",
        "text": "非法装备操作不扣步：已持刀时再次拿刀或裤子已满时再次穿裤，提交被拒绝且不扣行动步。"
      },
      {
        "id": "G003_gggame_courtyard_rps.WB.TC2.06",
        "col": "C2",
        "text": "移动产生真实位置变化：正常移动花费一步，经两秒户外状态抵达选定的家；户外期间不与其他人视为同地点。"
      },
      {
        "id": "G003_gggame_courtyard_rps.WB.TC2.07",
        "col": "C2",
        "text": "割除触发淘汰：同地点、持刀且目标零裤时完成割除，目标退出本局并失去后续出拳和行动能力。"
      },
      {
        "id": "G003_gggame_courtyard_rps.WB.TC2.08",
        "col": "C2",
        "text": "忙时动作按队列执行：忙时提交的有效动作按本人 FIFO 顺序执行，每项仅在提交时预留一步，不在启动时重复扣除。"
      },
      {
        "id": "G003_gggame_courtyard_rps.WB.TC2.09",
        "col": "C2",
        "text": "动作按完成时状态判定：已接受的割除在完成前因目标穿好裤子而失效，仍花费原步数和动作时间，不产生成功击杀。"
      },
      {
        "id": "G003_gggame_courtyard_rps.WB.TC2.10",
        "col": "C2",
        "text": "清空行动后才进入下一轮：存活玩家尚有步数、动作或队列时不提前开始下一次猜拳，清空后再开始。"
      },
      {
        "id": "G003_gggame_courtyard_rps.WB.TC2.11",
        "col": "C2",
        "text": "最后存活者获胜：经正常行动淘汰至仅剩一名存活者时判其获胜，终局停止未完成动作。"
      },
      {
        "id": "G003_gggame_courtyard_rps.WB.TC2.12",
        "col": "C2",
        "text": "原生再来一局：终局通过原生再玩流程进入新对局，不继续执行上一局的动作。"
      },
      {
        "id": "G003_gggame_courtyard_rps.WB.TC2.13",
        "col": "C2",
        "text": "新局角色状态：原生开局每名玩家处于自己的家且一条裤子、没有刀，零裤子时仍存活。"
      },
      {
        "id": "G003_gggame_courtyard_rps.WB.TC2.14",
        "col": "C2",
        "text": "拿刀动作：未持刀者通过原生拿刀动作获得永久持刀状态。"
      },
      {
        "id": "G003_gggame_courtyard_rps.WB.TC2.15",
        "col": "C2",
        "text": "穿裤子动作：未满三条时通过正常穿裤子动作使裤子计数恰好增加一条。"
      },
      {
        "id": "G003_gggame_courtyard_rps.WB.TC2.16",
        "col": "C2",
        "text": "脱裤子动作：双方同地点时正常执行脱裤子，使目标裤子计数减少一条而非直接造成击杀。"
      },
      {
        "id": "G003_gggame_courtyard_rps.WB.TC2.17",
        "col": "C2",
        "text": "并行动作：一名玩家正在执行动作时，另一名有步数玩家仍能接受并执行自己的有效动作。"
      },
      {
        "id": "G003_gggame_courtyard_rps.WB.TC2.18",
        "col": "C2",
        "text": "同刻结算优先级：穿裤子和割在同刻完成时先结算穿裤子，再按该真实状态处理割。"
      },
      {
        "id": "G003_gggame_courtyard_rps.WB.TC2.19",
        "col": "C2",
        "text": "轮间步数清理：进入下一轮猜拳时上一轮步数不跨轮保留。"
      },
      {
        "id": "G003_gggame_courtyard_rps.WB.TC2.20",
        "col": "C2",
        "text": "双端权威一致：两个真实客户端提交行动后，对同一已结算对局的裤子、持刀、位置和出局事实保持一致。"
      }
    ],
