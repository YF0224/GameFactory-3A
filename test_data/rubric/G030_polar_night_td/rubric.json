{
  "game_id": "G030_polar_night_td",
  "whitebox": {
    "mechanic": [
      {
        "id": "G030_polar_night_td.WB.TC2.01",
        "col": "C2",
        "text": "供电图与连通（主机制）：有效操作与状态变化：电网拓扑变化 → 各塔供电状态重算（断电塔停摆）"
      },
      {
        "id": "G030_polar_night_td.WB.TC2.02",
        "col": "C2",
        "text": "供电图与连通（主机制）：拒绝与边界：矿不足/路径格/占位格建造按 §4 I02 拒绝且无副作用；夜间建造被拒"
      },
      {
        "id": "G030_polar_night_td.WB.TC2.03",
        "col": "C2",
        "text": "超载断塔：产生实际超载时依低到高优先级断塔，直到负载恢复平衡。"
      },
      {
        "id": "G030_polar_night_td.WB.TC2.04",
        "col": "C2",
        "text": "负载与优先级：拒绝与边界：无超载时不断塔；优先级列表为空时按建造顺序自旧到新断"
      },
      {
        "id": "G030_polar_night_td.WB.TC2.05",
        "col": "C2",
        "text": "电杆破坏修复：电杆第三次被啃咬后摧毁使下游断电，正常修复五秒后恢复供电。"
      },
      {
        "id": "G030_polar_night_td.WB.TC2.06",
        "col": "C2",
        "text": "线路破坏与修复：拒绝与边界：矿不足修复被拒且不消耗；未损坏电杆修复指令无效"
      },
      {
        "id": "G030_polar_night_td.WB.TC2.07",
        "col": "C2",
        "text": "昼夜切换：通过原生昼间准备流程进入夜间攻势，夜末后进入下一昼。"
      },
      {
        "id": "G030_polar_night_td.WB.TC2.08",
        "col": "C2",
        "text": "多入口攻势：有效操作与状态变化：不同夜次从不同入口进攻（夜 1 东、夜 2 东＋南、夜 3 四入口）；同波敌人每 1.0 秒出生一只"
      },
      {
        "id": "G030_polar_night_td.WB.TC2.09",
        "col": "C2",
        "text": "暂停冻结：原生暂停期间昼夜计时与攻势模拟不推进，继续后恢复。"
      },
      {
        "id": "G030_polar_night_td.WB.TC2.10",
        "col": "C2",
        "text": "成功终局：- V01 成功条件：撑满第三夜 90 秒（未死亡敌人撤退）且核心未被摧毁 → 胜利结算（显示剩余核心 HP、总矿、断电时长）；结局按核心 HP 二选一（≥60% → 日出·全镇存活；<60% → 日出·残火南迁）。"
      },
      {
        "id": "G030_polar_night_td.WB.TC2.11",
        "col": "C2",
        "text": "失败或非失败边界：- V02 失败条件：核心 HP 归零 → 失败结算（注明夜次与破坏来源，任意时刻即时判负）。"
      },
      {
        "id": "G030_polar_night_td.WB.TC2.12",
        "col": "C2",
        "text": "原生恢复与重新开始：- V03 恢复语义：核心被毁 → 回档界面（回最近日间存档＝该日昼初状态，或全量重开）；日间存档为自动；重开全量重置。"
      },
      {
        "id": "G030_polar_night_td.WB.TC2.13",
        "col": "C2",
        "text": "采矿生产：供电采矿机在昼间每十秒产十矿，断电或进入夜间后不继续按昼间产出。"
      },
      {
        "id": "G030_polar_night_td.WB.TC2.14",
        "col": "C2",
        "text": "箭塔目标选择：供电箭塔按射程选择最接近核心的合法敌人并实际造成对应伤害。"
      },
      {
        "id": "G030_polar_night_td.WB.TC2.15",
        "col": "C2",
        "text": "减速塔：供电减速塔使两格范围内敌人实际减速百分之五十，离开作用范围恢复。"
      },
      {
        "id": "G030_polar_night_td.WB.TC2.16",
        "col": "C2",
        "text": "原生优先级排序：玩家通过原生排序界面调整优先级后，实际超载断塔遵循新顺序。"
      },
      {
        "id": "G030_polar_night_td.WB.TC2.17",
        "col": "C2",
        "text": "夜间建造禁用：夜间不能新建建筑，但原生修复和调优先级仍可使用。"
      },
      {
        "id": "G030_polar_night_td.WB.TC2.18",
        "col": "C2",
        "text": "夜终撤退：一夜九十秒到点后未死亡敌人撤退，当夜判守而非继续无限夜战。"
      },
      {
        "id": "G030_polar_night_td.WB.TC2.19",
        "col": "C2",
        "text": "第三夜极寒：第三夜发电机有效供能降至七，核心作为五点负载计入实际供电平衡。"
      },
      {
        "id": "G030_polar_night_td.WB.TC2.20",
        "col": "C2",
        "text": "损坏跨昼保留：未修复的损坏电杆跨入下一昼仍损坏，不因昼夜切换免费恢复。"
      }
    ],
