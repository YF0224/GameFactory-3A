{
  "game_id": "G058_pitch_dreams_football",
  "whitebox": {
    "mechanic": [
      {
        "id": "G058_pitch_dreams_football.WB.TC2.01",
        "col": "C2",
        "text": "短传转移球权并推进：正常选择接球目标并成功短传后持球人切换、进度增加百分之八，消耗执行者体力。"
      },
      {
        "id": "G058_pitch_dreams_football.WB.TC2.02",
        "col": "C2",
        "text": "直塞成功推进攻势：正常直塞成功时进度增加百分之二十二，失误则转入防守。"
      },
      {
        "id": "G058_pitch_dreams_football.WB.TC2.03",
        "col": "C2",
        "text": "射门进球改变比分：通过正常攻势完成射门，真实进球后改变对应队伍比分并进入后续原生流程。"
      },
      {
        "id": "G058_pitch_dreams_football.WB.TC2.04",
        "col": "C2",
        "text": "抢断成功切换攻防：防守时通过原生抢断成功夺得球权并转为进攻，失败时让对方推进。"
      },
      {
        "id": "G058_pitch_dreams_football.WB.TC2.05",
        "col": "C2",
        "text": "比赛按半场阶段推进：正常比赛经历开场、上半场、中场、下半场和终场，中场可进入原生换人或战术窗口。"
      },
      {
        "id": "G058_pitch_dreams_football.WB.TC2.06",
        "col": "C2",
        "text": "终场按赛果奖励一次：正常结束比赛按胜平负分别结算对应招募点、训练资源与资金，重复查看结算不重复发放。"
      },
      {
        "id": "G058_pitch_dreams_football.WB.TC2.07",
        "col": "C2",
        "text": "抽卡真实消费招募点：通过原生单抽消耗一百招募点并得到对应球员结果，重复球员转换为碎片。"
      },
      {
        "id": "G058_pitch_dreams_football.WB.TC2.08",
        "col": "C2",
        "text": "阵容底线阻止非法出售：原生转会操作不能出售首发、最后一名门将或使球员总数少于五人。"
      },
      {
        "id": "G058_pitch_dreams_football.WB.TC2.09",
        "col": "C2",
        "text": "培养入阵后继续下一场：比赛获得资源后通过原生训练培养球员并入阵，下一场实际使用该阵容继续赛程。"
      },
      {
        "id": "G058_pitch_dreams_football.WB.TC2.10",
        "col": "C2",
        "text": "暂停冻结比赛时间：原生暂停期间比赛时间和决策模拟不推进，继续后恢复。"
      },
      {
        "id": "G058_pitch_dreams_football.WB.TC2.11",
        "col": "C2",
        "text": "刷新恢复比赛并暂停：比赛中刷新后恢复原有同局比赛状态并保持暂停，不直接创建新赛果。"
      },
      {
        "id": "G058_pitch_dreams_football.WB.TC2.12",
        "col": "C2",
        "text": "确认新开局才重置进度：原生重新开始的取消操作不改变当前档，二次确认后才清空档内进度并进入新局。"
      },
      {
        "id": "G058_pitch_dreams_football.WB.TC2.13",
        "col": "C2",
        "text": "盘带推进：原生盘带成功使持球人推进百分之十五，失败和造犯规走对应原生状态。"
      },
      {
        "id": "G058_pitch_dreams_football.WB.TC2.14",
        "col": "C2",
        "text": "冲刺推进：原生冲刺成功推进百分之二十四并消耗执行者体力。"
      },
      {
        "id": "G058_pitch_dreams_football.WB.TC2.15",
        "col": "C2",
        "text": "传中高球：正常传中成功后指定目标进入高球争夺，随后可选择合法高球动作。"
      },
      {
        "id": "G058_pitch_dreams_football.WB.TC2.16",
        "col": "C2",
        "text": "头球射门：在合法高球场景执行头球攻门，真实进球时改变比分。"
      },
      {
        "id": "G058_pitch_dreams_football.WB.TC2.17",
        "col": "C2",
        "text": "高球停球：高球阶段正常停球成功后转为地面持球，失误让对方发动攻势。"
      },
      {
        "id": "G058_pitch_dreams_football.WB.TC2.18",
        "col": "C2",
        "text": "铲球犯规：原生铲球按其犯规风险处理，产生对方任意球或点球时进入对应原生流程。"
      },
      {
        "id": "G058_pitch_dreams_football.WB.TC2.19",
        "col": "C2",
        "text": "门将扑救：对方射门后由门将执行实际扑救，成功保持比分，失败增加对方比分。"
      },
      {
        "id": "G058_pitch_dreams_football.WB.TC2.20",
        "col": "C2",
        "text": "点球罚球：原生点球流程可实际罚球，按成功或失败更新比分及后续球权。"
      }
    ],
