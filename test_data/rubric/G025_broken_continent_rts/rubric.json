  "whitebox": {
    "mechanic": [
      {
        "id": "G025_broken_continent_rts.WB.TC2.01",
        "col": "C2",
        "text": "生产消耗资源并得到可用单位：通过默认 F01 的原生生产流程花费三十物资和一人口，八秒后得到可实际操作的救援民兵。"
      },
      {
        "id": "G025_broken_continent_rts.WB.TC2.02",
        "col": "C2",
        "text": "救援获得有限兵源：正常从区域据点救援增加幸存者兵源，已阵亡部队不自然返还为可再次使用的兵源。"
      },
      {
        "id": "G025_broken_continent_rts.WB.TC2.03",
        "col": "C2",
        "text": "三段组合产生稳定攻击类型：通过原生装备选择改变平台、能源或载荷后使用对应攻击类型；切回已用组合恢复原 damage_id。"
      },
      {
        "id": "G025_broken_continent_rts.WB.TC2.04",
        "col": "C2",
        "text": "护甲按比例减伤：正常攻击有甲目标时按冻结比例公式扣血，不能把护甲直接从攻击值中减去。"
      },
      {
        "id": "G025_broken_continent_rts.WB.TC2.05",
        "col": "C2",
        "text": "战争迷雾保留静态记忆：侦察离开后的区域变为灰色记忆，未再看到的敌方对象不泄漏实时移动和状态。"
      },
      {
        "id": "G025_broken_continent_rts.WB.TC2.06",
        "col": "C2",
        "text": "同一格侦察情报只结算一次：正常首次侦察新格获得两点情报，再次进入同一格不重复领取。"
      },
      {
        "id": "G025_broken_continent_rts.WB.TC2.07",
        "col": "C2",
        "text": "情报干预改变外交关系：消耗六十情报执行提升敌对，指定 A 对 B 的有向敌对度增加四十并保持九十秒。"
      },
      {
        "id": "G025_broken_continent_rts.WB.TC2.08",
        "col": "C2",
        "text": "跨区推进可解锁阵营：通过原生跨区救援、科技或外交路线满足交付中已声明的解锁条件后，获得对应阵营操作权限。"
      },
      {
        "id": "G025_broken_continent_rts.WB.TC2.09",
        "col": "C2",
        "text": "暂停冻结全局模拟：原生暂停期间生产、战斗和世界时间都不推进，恢复后继续。"
      },
      {
        "id": "G025_broken_continent_rts.WB.TC2.10",
        "col": "C2",
        "text": "达到已配置目标后获胜：开局展示可配置目标，通过正常操作达到该局目标后进入对应胜利结算。"
      },
      {
        "id": "G025_broken_continent_rts.WB.TC2.11",
        "col": "C2",
        "text": "触发已配置条件后失败：开局展示失败条件，经正常玩法触发后进入对应失败结算。"
      },
      {
        "id": "G025_broken_continent_rts.WB.TC2.12",
        "col": "C2",
        "text": "失败后原生重开：失败后通过原生重新开始进入新局，不延续上一局的终局状态。"
      },
      {
        "id": "G025_broken_continent_rts.WB.TC2.13",
        "col": "C2",
        "text": "受伤怒气：F02承受实际伤害按每点伤害积累一点公共怒气，满三千触发四十五秒爆发，结束进入疲劳。"
      },
      {
        "id": "G025_broken_continent_rts.WB.TC2.14",
        "col": "C2",
        "text": "节点失地衰减：F03领主失去其绑定节点时属性降低百分之三十，收复该节点后恢复。"
      },
      {
        "id": "G025_broken_continent_rts.WB.TC2.15",
        "col": "C2",
        "text": "伤害身份学习：F04被同damage_id实际命中后为该ID单独积累抗性，换另一ID不继承其学习值。"
      },
      {
        "id": "G025_broken_continent_rts.WB.TC2.16",
        "col": "C2",
        "text": "潜伏感染转化：合法宿体实际感染后保留原阵营控制，经过一百二十模拟秒才转为F05。"
      },
      {
        "id": "G025_broken_continent_rts.WB.TC2.17",
        "col": "C2",
        "text": "灾害引导：通过原生高价引导花费二百情报，将地脊灾害路径侧向改变一段，普通诱饵不能替代。"
      },
      {
        "id": "G025_broken_continent_rts.WB.TC2.18",
        "col": "C2",
        "text": "观察识别：F07对未识别目标类型伤害减半，连续观察三秒后该类型识别结果在本阵营共享。"
      },
      {
        "id": "G025_broken_continent_rts.WB.TC2.19",
        "col": "C2",
        "text": "捕食成长：F08正常消灭目标后获得其最大HP十分之一的生物量，达到阈值才升级形态且不超过四形态。"
      },
      {
        "id": "G025_broken_continent_rts.WB.TC2.20",
        "col": "C2",
        "text": "局部链接上限：半径十格内链接最多十二名有效成员，十二人时ATK增益为百分之十一、移速增益为百分之八点八。"
      },
      {
        "id": "G025_broken_continent_rts.WB.TC2.21",
        "col": "C2",
        "text": "地形雕刻：通过原生规则面板按每格八十响应能雕刻地形，改变实际通路或高地，不只修改文本。"
      },
      {
        "id": "G025_broken_continent_rts.WB.TC2.22",
        "col": "C2",
        "text": "生命资源驱动力：吸收合法目标时按固定等级和当前生命公式获得非负驱动力，同时扣除对应生命资源，不能重复刷同目标。"
      },
      {
        "id": "G025_broken_continent_rts.WB.TC2.23",
        "col": "C2",
        "text": "全场规则轮换：每九十模拟秒切换一条全场规则且提前十五秒预告，切换时撤销上一条规则效果。"
      },
      {
        "id": "G025_broken_continent_rts.WB.TC2.24",
        "col": "C2",
        "text": "技术样本仿制：正常拾取战斗掉落技术样本后解锁对应仿制单位，其HP和ATK分别按来源基础值的百分之八十五和八十生成。"
      },
      {
        "id": "G025_broken_continent_rts.WB.TC2.25",
        "col": "C2",
        "text": "根段资源风险：一个根段通过原生提取只发放一次五百通用能量，并同步使该段扩张间隔缩为二十二秒持续六十秒。"
      }
