{
  "game_id": "G008_dock_beacon_cs",
  "whitebox": {
    "mechanic": [
      {
        "id": "G008_dock_beacon_cs.WB.TC2.01",
        "col": "C2",
        "text": "两个真实客户端共同开局：两个真实客户端通过原生私有房间流程进入同一回合，并观察一致的队伍和回合状态。"
      },
      {
        "id": "G008_dock_beacon_cs.WB.TC2.02",
        "col": "C2",
        "text": "移动与瞄准作用于角色：正常移动输入改变真实角色位置，独立瞄准输入改变射击方向。"
      },
      {
        "id": "G008_dock_beacon_cs.WB.TC2.03",
        "col": "C2",
        "text": "购买真实扣款并装备：在购买阶段用足额资金购买步枪，扣除二千七百资金并获得可实际使用的武器。"
      },
      {
        "id": "G008_dock_beacon_cs.WB.TC2.04",
        "col": "C2",
        "text": "正常命中造成对应伤害：正常射击命中身体与头部时按原生部位和护甲伤害规则改变目标生命值。"
      },
      {
        "id": "G008_dock_beacon_cs.WB.TC2.05",
        "col": "C2",
        "text": "不可穿透掩体阻挡射击：相同射线上不可穿透材质阻挡对其后目标的伤害。"
      },
      {
        "id": "G008_dock_beacon_cs.WB.TC2.06",
        "col": "C2",
        "text": "核心唯一归属与掉落：携带者正常拾取后核心仅归其一人，携带者死亡时核心落地且双方客户端状态一致。"
      },
      {
        "id": "G008_dock_beacon_cs.WB.TC2.07",
        "col": "C2",
        "text": "目标交互被伤害打断：正常开始安装或拆除后受到有效伤害，交互被打断而不继续完成。"
      },
      {
        "id": "G008_dock_beacon_cs.WB.TC2.08",
        "col": "C2",
        "text": "安装后防守拆除获胜：攻击方正常安装核心后，防守方在倒计时内完成原生拆除并赢得回合。"
      },
      {
        "id": "G008_dock_beacon_cs.WB.TC2.09",
        "col": "C2",
        "text": "未安装超时由防守获胜：回合时间耗尽且核心未安装时，判定防守方赢得该回合。"
      },
      {
        "id": "G008_dock_beacon_cs.WB.TC2.10",
        "col": "C2",
        "text": "死亡后退出当前回合控制：角色死亡后无法继续控制该干员，转入合法观战流程。"
      },
      {
        "id": "G008_dock_beacon_cs.WB.TC2.11",
        "col": "C2",
        "text": "下一回合清理旧状态：回合结束进入下一回合后干员复位，核心和交互进度不继承上一回合。"
      },
      {
        "id": "G008_dock_beacon_cs.WB.TC2.12",
        "col": "C2",
        "text": "整场比分结算：正常回合累计至一方先获得三胜后完成比赛，两个真实客户端显示一致的最终获胜方。"
      },
      {
        "id": "G008_dock_beacon_cs.WB.TC2.13",
        "col": "C2",
        "text": "蹲伏精度：原生蹲伏改变对应移动与射击精度参数，站起后恢复。"
      },
      {
        "id": "G008_dock_beacon_cs.WB.TC2.14",
        "col": "C2",
        "text": "资金不足拒绝购买：购买阶段余额不足时原生购买被拒绝，不获得武器也不扣出负余额。"
      },
      {
        "id": "G008_dock_beacon_cs.WB.TC2.15",
        "col": "C2",
        "text": "距离衰减：同一武器在不同有效距离命中同部位时，实际伤害按距离衰减规则变化。"
      },
      {
        "id": "G008_dock_beacon_cs.WB.TC2.16",
        "col": "C2",
        "text": "可穿透材质：正常射击穿过允许穿透的材质后按衰减伤害命中其后目标。"
      },
      {
        "id": "G008_dock_beacon_cs.WB.TC2.17",
        "col": "C2",
        "text": "安装核心：合法携带者在安装区完成原生安装后核心转入已安装倒计时状态。"
      },
      {
        "id": "G008_dock_beacon_cs.WB.TC2.18",
        "col": "C2",
        "text": "掉落核心拾取：携带者死亡掉落核心后，另一合法干员通过原生拾取接管唯一核心。"
      },
      {
        "id": "G008_dock_beacon_cs.WB.TC2.19",
        "col": "C2",
        "text": "临时增益：正常获得临时增益后按声明规则生效并在到期后撤销，不无限叠加。"
      },
      {
        "id": "G008_dock_beacon_cs.WB.TC2.20",
        "col": "C2",
        "text": "爆炸回合胜利：已安装核心在未拆除情况下倒计时结束，按原生爆炸流程判攻击方回合胜利。"
      }
    ],
