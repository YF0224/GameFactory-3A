{
  "game_id": "G038_twin_truck_rescue",
  "whitebox": {
    "mechanic": [
      {
        "id": "G038_twin_truck_rescue.WB.TC2.01",
        "col": "C2",
        "text": "分工与转运载荷（主机制）：有效操作与状态变化：B 载荷改变重量→改变加速/转向参数；A 拖拽等效载荷随目标车残余件数实时变化"
      },
      {
        "id": "G038_twin_truck_rescue.WB.TC2.02",
        "col": "C2",
        "text": "分工与转运载荷（主机制）：拒绝与边界：单方确认的转运不生效；B 货斗满 4 件后转运拒绝；A 无转运权限"
      },
      {
        "id": "G038_twin_truck_rescue.WB.TC2.03",
        "col": "C2",
        "text": "货损：有效操作与状态变化：按冲击档位对货物扣耐久，交付时结算合格/损耗"
      },
      {
        "id": "G038_twin_truck_rescue.WB.TC2.04",
        "col": "C2",
        "text": "路线选择：有效操作与状态变化：稳路远（安全）vs 险路近（落石区阻挡、货损风险）；双车可异路（A 拖拽与 B 载货可分头）"
      },
      {
        "id": "G038_twin_truck_rescue.WB.TC2.05",
        "col": "C2",
        "text": "绞盘拖拽与绳索：有效操作与状态变化：连接后目标车进入 connected→towing；拖拽中距离 >12 米触发断绳事件（connection_broken，目标车留在原地）"
      },
      {
        "id": "G038_twin_truck_rescue.WB.TC2.06",
        "col": "C2",
        "text": "绞盘拖拽与绳索：拒绝与边界：连接中重复按 E 无效；B 端按 E 不可连接绞盘"
      },
      {
        "id": "G038_twin_truck_rescue.WB.TC2.07",
        "col": "C2",
        "text": "落石清障与道路恢复：有效操作与状态变化：blocked→clearing（5 秒进度，中断保留、2 秒内重按可续）→cleared；cleared 后道路对全车恢复通行"
      },
      {
        "id": "G038_twin_truck_rescue.WB.TC2.08",
        "col": "C2",
        "text": "交付幂等与掉线安全：有效操作与状态变化：双车齐到才结算；重复交互不重复计分；一端掉线→安全结束不判 PASS"
      },
      {
        "id": "G038_twin_truck_rescue.WB.TC2.09",
        "col": "C2",
        "text": "暂停冻结与继续：- G06 掉线、暂停与同步（本包冻结值）：主机为权威端（60 Hz 模拟、状态快照 10 Hz 下发）；一端断开→会话安全结束（不判 PASS、不崩溃），计入会话成功率；任一端 Esc 暂停冻结双端模拟与计时（仅权威端计时权威）；同帧双端对同一目标的并发交互按客户端 ID 升序裁决（A 先于 B）；fixed_seed=1038 冻结碎石分布、落石区位置与天气表现。"
      },
      {
        "id": "G038_twin_truck_rescue.WB.TC2.10",
        "col": "C2",
        "text": "成功终局：- V01 成功条件：600 秒内双车齐到交付站且合格件合计 ≥6 → 胜利结算（显示各车路线、件数与逐件耐久）。"
      },
      {
        "id": "G038_twin_truck_rescue.WB.TC2.11",
        "col": "C2",
        "text": "失败或非失败边界：- V02 失败条件：合格 <6 件或超时 → 失败结算；一端掉线→安全结束不判 PASS（不计胜负、计入会话成功率）。"
      },
      {
        "id": "G038_twin_truck_rescue.WB.TC2.12",
        "col": "C2",
        "text": "原生恢复与重新开始：- V03 恢复语义：翻车按 R 复位到最近路段检查点（货损已计、载荷保留、计时继续）；断绳重新连接；判负一键重开全量重置（seed 复现）。"
      }
    ],
