{
  "game_id": "G015_garden_revival",
  "whitebox": {
    "mechanic": [
      {
        "id": "G015_garden_revival.WB.TC2.01",
        "col": "C2",
        "text": "能力获得持久：正常取得能力节点后相应能力标志在跨区时保留。"
      },
      {
        "id": "G015_garden_revival.WB.TC2.02",
        "col": "C2",
        "text": "节点幂等：重复交互已取得的能力节点不重复发放能力或触发新进度。"
      },
      {
        "id": "G015_garden_revival.WB.TC2.03",
        "col": "C2",
        "text": "缺能力门禁：没有对应能力接触门禁时阻挡并提示所缺能力，不直接传送通过。"
      },
      {
        "id": "G015_garden_revival.WB.TC2.04",
        "col": "C2",
        "text": "未解锁指令：能力获得前对应特殊动作输入无效，不产生该能力位移。"
      },
      {
        "id": "G015_garden_revival.WB.TC2.05",
        "col": "C2",
        "text": "捷径开通：用对应能力打开旧区捷径后实际跨区路径缩短且地图标记更新。"
      },
      {
        "id": "G015_garden_revival.WB.TC2.06",
        "col": "C2",
        "text": "捷径拒绝：缺少对应能力时原生捷径门交互被拒绝，不改变门状态。"
      },
      {
        "id": "G015_garden_revival.WB.TC2.07",
        "col": "C2",
        "text": "普通坠落：前三次区间坠落分别回当前检查点并使容错计数加一。"
      },
      {
        "id": "G015_garden_revival.WB.TC2.08",
        "col": "C2",
        "text": "检查点更新：经正常路线抵达新检查点后，后续坠落恢复到新的检查点。"
      },
      {
        "id": "G015_garden_revival.WB.TC2.09",
        "col": "C2",
        "text": "暂停计时：原生暂停冻结能力冷却和模拟计时，继续后从原值恢复。"
      },
      {
        "id": "G015_garden_revival.WB.TC2.10",
        "col": "C2",
        "text": "终点结算：集齐三项能力后正常抵达最深处终点，进入复苏结算。"
      },
      {
        "id": "G015_garden_revival.WB.TC2.11",
        "col": "C2",
        "text": "结算只读：结算中保留收集与能力快照，查看面板不修改已结算状态。"
      },
      {
        "id": "G015_garden_revival.WB.TC2.12",
        "col": "C2",
        "text": "全量重开：原生全量重开清空能力、收集和捷径状态，回到初始局。"
      },
      {
        "id": "G015_garden_revival.WB.TC2.13",
        "col": "C2",
        "text": "地面基础移动：正常地面移动与基础跳跃遵循侧视移动规则，空中不能无限续跳。"
      },
      {
        "id": "G015_garden_revival.WB.TC2.14",
        "col": "C2",
        "text": "冲刺裂隙：获得冲刺后通过对应裂隙门禁，未取得冲刺时同一路线不能以基础跳越过。"
      },
      {
        "id": "G015_garden_revival.WB.TC2.15",
        "col": "C2",
        "text": "二段跳高台：取得二段跳后在空中追加合法跳跃抵达对应高台，落地恢复次数。"
      },
      {
        "id": "G015_garden_revival.WB.TC2.16",
        "col": "C2",
        "text": "抓壁通路：取得抓壁后通过对应墙面路径，离壁不能无限刷新跳跃次数。"
      },
      {
        "id": "G015_garden_revival.WB.TC2.17",
        "col": "C2",
        "text": "唯一收集：拾取同一ID光合晶只增加一次收集件数，不因重新进入区域重复领取。"
      },
      {
        "id": "G015_garden_revival.WB.TC2.18",
        "col": "C2",
        "text": "最近存档恢复：主动保存后改变局内状态，再Load时按最近快照恢复能力、收集和机关状态。"
      },
      {
        "id": "G015_garden_revival.WB.TC2.19",
        "col": "C2",
        "text": "跨区收集保留：通过原生路径跨区并回访时，已收集晶体不重新出现，已开捷径保持。"
      },
      {
        "id": "G015_garden_revival.WB.TC2.20",
        "col": "C2",
        "text": "容错阈值：同检查点区间第四次坠落触发区间临时状态重置并清零容错，前三次仅回检查点。"
      }
    ],
