{
  "game_id": "G020_tidal_glyphs",
  "whitebox": {
    "mechanic": [
      {
        "id": "G020_tidal_glyphs.WB.TC2.01",
        "col": "C2",
        "text": "译义暂定：给未知符号赋义后转入暂定，未有佐证时不直接证实。"
      },
      {
        "id": "G020_tidal_glyphs.WB.TC2.02",
        "col": "C2",
        "text": "非法转移：尝试从未知直接证实或未经回滚从证实变暂定被拒绝。"
      },
      {
        "id": "G020_tidal_glyphs.WB.TC2.03",
        "col": "C2",
        "text": "误译代价：赋错译义后操作对应机关被拒绝且误译计数恰好增加一次。"
      },
      {
        "id": "G020_tidal_glyphs.WB.TC2.04",
        "col": "C2",
        "text": "缺前驱机关：缺少前厅佐证时操作依赖该佐证的机关被拒绝并保留原状态。"
      },
      {
        "id": "G020_tidal_glyphs.WB.TC2.05",
        "col": "C2",
        "text": "假设回滚：原生回滚将选定符号假设恢复未知，允许重新赋义。"
      },
      {
        "id": "G020_tidal_glyphs.WB.TC2.06",
        "col": "C2",
        "text": "缺材料拒绝：材料不足时组合被拒绝，现有材料不被扣除。"
      },
      {
        "id": "G020_tidal_glyphs.WB.TC2.07",
        "col": "C2",
        "text": "存读快照：节点保存后改变假设、道具和机关，再读档恢复原快照。"
      },
      {
        "id": "G020_tidal_glyphs.WB.TC2.08",
        "col": "C2",
        "text": "守望者演出：满足三项原生前驱后依次执行降光、轮廓、贴近、闪白，再恢复控制并登记壁龛线索。"
      },
      {
        "id": "G020_tidal_glyphs.WB.TC2.09",
        "col": "C2",
        "text": "暂停：原生暂停冻结总倒计时和正在执行的事件时序。"
      },
      {
        "id": "G020_tidal_glyphs.WB.TC2.10",
        "col": "C2",
        "text": "房间重置：原生房间重置清除当前室临时机关与假设，保留道具及已证实符号。"
      },
      {
        "id": "G020_tidal_glyphs.WB.TC2.11",
        "col": "C2",
        "text": "总时限：实际模拟时间达到3600秒时进入涨潮沉没失败结算。"
      },
      {
        "id": "G020_tidal_glyphs.WB.TC2.12",
        "col": "C2",
        "text": "全量重开：原生全量重开清空译义、物品、机关和本局事件标志。"
      },
      {
        "id": "G020_tidal_glyphs.WB.TC2.13",
        "col": "C2",
        "text": "房间佐证登记：在前厅正常调查潮汐壁画后，线索笔记登记A对应潮的来源，异室不能远程取证。"
      },
      {
        "id": "G020_tidal_glyphs.WB.TC2.14",
        "col": "C2",
        "text": "反光刻片制作：同时持有铜镜与刻刀时通过原生组合得到反光刻片并消耗对应材料。"
      },
      {
        "id": "G020_tidal_glyphs.WB.TC2.15",
        "col": "C2",
        "text": "钥芯制作：持有反光刻片和月相盘时通过原生组合得到封印钥芯。"
      },
      {
        "id": "G020_tidal_glyphs.WB.TC2.16",
        "col": "C2",
        "text": "月门双前驱：内室月门仅在B已证实且持有反光刻片时开启，缺少任一前驱仍拒绝。"
      },
      {
        "id": "G020_tidal_glyphs.WB.TC2.17",
        "col": "C2",
        "text": "六槽封印对位：六符号已证实且持有钥芯时，按真实译义对位六槽才能解除密室封印。"
      },
      {
        "id": "G020_tidal_glyphs.WB.TC2.18",
        "col": "C2",
        "text": "无存档拒绝：没有有效快照时原生读档入口不能伪造进度或清空为另一存档。"
      },
      {
        "id": "G020_tidal_glyphs.WB.TC2.19",
        "col": "C2",
        "text": "事件去重：回声守望者事件本局触发后再次满足条件不重复触发。"
      },
      {
        "id": "G020_tidal_glyphs.WB.TC2.20",
        "col": "C2",
        "text": "结算评级：正常完成逃脱时按实际误译次数和用时生成对应评级，评级不改变唯一逃脱条件。"
      }
    ],
