{
  "game_id": "G040_endurance_race",
  "whitebox": {
    "mechanic": [
      {
        "id": "G040_endurance_race.WB.TC2.01",
        "col": "C2",
        "text": "风格磨耗：已判定为激进、均衡或保守的一圈结算分别扣12、8或6抓地，耐用升级正确减免磨耗。"
      },
      {
        "id": "G040_endurance_race.WB.TC2.02",
        "col": "C2",
        "text": "进站维修与加油：有效操作与状态变化：换胎 6 秒＋每 10% 车损 2 秒＋加油 2 秒；换胎后抓地回 100、燃油补满；位次按耗时自然变化"
      },
      {
        "id": "G040_endurance_race.WB.TC2.03",
        "col": "C2",
        "text": "报废退赛：真实车损达到百分之百时该赛段零分退赛，并可进入后续赛段。"
      },
      {
        "id": "G040_endurance_race.WB.TC2.04",
        "col": "C2",
        "text": "赛段积分与升级：有效操作与状态变化：名次 → 积分（10/8/6/4）→ 跨段持久；兑换升级（每项每局限 1 次）改变下段性能（引擎极速 210/空力判定线 126/耐用磨耗 ×0.8）"
      },
      {
        "id": "G040_endurance_race.WB.TC2.05",
        "col": "C2",
        "text": "AI 对手行为（P0 修复：有效操作与状态变化：按规则表执行——红隼（激进）：进站阈值抓地 <30；超车条件＝直线段 ≥200 m 且距前车 ≤15 m 且自身车损 <50%。信天翁（保守）：进站阈值抓地 <50；刹车点提前 10%；仅在前车速度低于自身 70% 时超车。灰鸥（均衡）：进站阈值抓地 <40；超车条件＝直线段 ≥200 m 且距前车 ≤10 m。三者均遵守安全车规则与燃油下限（油 <25% 时下次进站顺带补满）"
      },
      {
        "id": "G040_endurance_race.WB.TC2.06",
        "col": "C2",
        "text": "燃油消耗：完整一圈按激进、均衡或保守风格分别消耗32、27或22个百分点燃油。"
      },
      {
        "id": "G040_endurance_race.WB.TC2.07",
        "col": "C2",
        "text": "天气与路面变化：有效操作与状态变化：段级天气（晴/阵雨/夜雨）抓地 −10%；非铺装短区再 −15%；赛段三积水段打滑判定线 −10 km/h"
      },
      {
        "id": "G040_endurance_race.WB.TC2.08",
        "col": "C2",
        "text": "安全车状态机：原生碰撞或脚本条件触发安全车，实际限速80并领跑一圈后退回绿旗。"
      },
      {
        "id": "G040_endurance_race.WB.TC2.09",
        "col": "C2",
        "text": "暂停冻结与继续：暂停冻结竞速、磨耗、燃油、AI 与安全车状态（G12）；暂停菜单提供「继续 / 中断保存并退出 / 退赛本段 / 重开」"
      },
      {
        "id": "G040_endurance_race.WB.TC2.10",
        "col": "C2",
        "text": "成功终局：- V01 成功条件：三赛段后累计积分排名第一（同分按 G12 裁决）→ 登顶总评结算（显示各段名次、总罚时、升级清单、退赛记录）。"
      },
      {
        "id": "G040_endurance_race.WB.TC2.11",
        "col": "C2",
        "text": "同分排名：总积分相同时按总罚时更少者排前，再同按退赛段数更少者排前。"
      },
      {
        "id": "G040_endurance_race.WB.TC2.12",
        "col": "C2",
        "text": "赛中检查点：出界后原生复位到最近检查点，比赛计时、罚时和车辆资源不回退。"
      },
      {
        "id": "G040_endurance_race.WB.TC2.13",
        "col": "C2",
        "text": "长流程中断恢复：通过暂停菜单中断保存并退出，再从主菜单继续时恢复最近长流程检查点及实际赛季状态。"
      },
      {
        "id": "G040_endurance_race.WB.TC2.14",
        "col": "C2",
        "text": "抓地阈值：实际轮胎抓地跌至对应阈值后改变车辆打滑判定，不只改HUD。"
      },
      {
        "id": "G040_endurance_race.WB.TC2.15",
        "col": "C2",
        "text": "碰撞独立处罚：真实碰撞同时对双方增加百分之十车损并各计三秒罚时。"
      },
      {
        "id": "G040_endurance_race.WB.TC2.16",
        "col": "C2",
        "text": "切弯独立处罚：实际切弯获利时对当前赛段成绩计五秒罚时。"
      },
      {
        "id": "G040_endurance_race.WB.TC2.17",
        "col": "C2",
        "text": "低油量警戒：真实燃油降至百分之十五以下出现警戒，燃油归零时引擎停机并按该段零分退赛。"
      },
      {
        "id": "G040_endurance_race.WB.TC2.18",
        "col": "C2",
        "text": "安全车超车处罚：安全车领跑阶段原生驾驶超车实际记三秒罚时，恢复绿旗后不沿用禁超车。"
      },
      {
        "id": "G040_endurance_race.WB.TC2.19",
        "col": "C2",
        "text": "驾驶风格分类：一圈高负荷入弯次数达到四或碰撞加切弯达到二时，该圈结算为激进风格并按其磨耗规则生效。"
      },
      {
        "id": "G040_endurance_race.WB.TC2.20",
        "col": "C2",
        "text": "进站条件拒绝：不在维修通道判定体内的进站请求不直接开始维修或免费回满状态。"
      }
    ],
